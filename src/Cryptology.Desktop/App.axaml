<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Cryptology.Desktop.App" RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBackground">#0D1420</SolidColorBrush>
          <SolidColorBrush x:Key="Surface">#151F2E</SolidColorBrush>
          <SolidColorBrush x:Key="SurfaceBorder">#28374C</SolidColorBrush>
          <SolidColorBrush x:Key="SidebarBackground">#101925</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBackground">#EEF3F8</SolidColorBrush>
          <SolidColorBrush x:Key="Surface">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="SurfaceBorder">#D3DFEB</SolidColorBrush>
          <SolidColorBrush x:Key="SidebarBackground">#E5EDF5</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <SolidColorBrush x:Key="Accent">#39D4B3</SolidColorBrush>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window"><Setter Property="Background" Value="{DynamicResource AppBackground}" /><Setter Property="FontFamily" Value="Segoe UI" /><Setter Property="FontSize" Value="14" /></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="{DynamicResource Surface}" /><Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="18" /><Setter Property="Margin" Value="0,0,0,14" /></Style>
    <Style Selector="Button"><Setter Property="Padding" Value="13,8" /><Setter Property="CornerRadius" Value="6" /><Setter Property="MinHeight" Value="36" /></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="{DynamicResource Accent}" /><Setter Property="Foreground" Value="#0D2526" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="6" /><Setter Property="MinHeight" Value="36" /></Style>
    <Style Selector="TextBlock.caption"><Setter Property="Opacity" Value="0.7" /><Setter Property="FontSize" Value="12" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style Selector="TextBlock.section"><Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,10" /></Style>
    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="10,11" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Margin" Value="0,2" /></Style>
  </Application.Styles>
</Application>
