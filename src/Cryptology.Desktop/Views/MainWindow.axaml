<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Cryptology.Desktop.Views.MainWindow" Title="PADO Cryptology" Width="1320" Height="900"
        MinWidth="960" MinHeight="660" WindowStartupLocation="CenterScreen">
  <Grid ColumnDefinitions="230,*">
    <Border Background="{DynamicResource SidebarBackground}" Padding="18,26" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel>
          <TextBlock Text="PADO" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource Accent}" LetterSpacing="4" />
          <TextBlock Text="CRYPTOLOGY" FontSize="15" FontWeight="SemiBold" LetterSpacing="2" />
          <TextBlock Text="{Binding L[Learn]}" Classes="caption" Margin="0,12,0,24" />
        </StackPanel>
        <TextBlock Grid.Row="1" Text="TOOLKIT / 10" Classes="caption" Margin="10,0,0,8" />
        <ListBox Grid.Row="2" Name="ModuleNavigation" ItemsSource="{Binding Tools}" SelectedItem="{Binding SelectedTool}" Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" TextWrapping="Wrap" /></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3" Spacing="10" Margin="0,20,0,0">
          <TextBlock Text="{Binding L[Language]}" Classes="caption" />
          <CheckBox Name="UiLanguageToggle" Content="Українська" IsChecked="{Binding L.Ukrainian}" />
          <CheckBox Name="ThemeToggle" Content="{Binding L[Dark]}" IsChecked="{Binding DarkTheme}" />
          <TextBlock Text="v1.0 · .NET 10 / Avalonia" Classes="caption" Margin="0,10,0,0" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="28,26,28,18">
      <StackPanel Margin="0,0,0,20" Spacing="7">
        <TextBlock Text="{Binding SelectedTool.Title}" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Text="{Binding SelectedTool.Description}" TextWrapping="Wrap" Opacity="0.7" />
      </StackPanel>
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ContentControl Name="ToolHost" />
      </ScrollViewer>
      <Border Grid.Row="2" Padding="0,12,0,0"><TextBlock Text="{Binding L[Caution]}" Classes="caption" /></Border>
    </Grid>
  </Grid>
</Window>
